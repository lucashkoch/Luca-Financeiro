# IA local via Ollama (opcional)
OLLAMA_ENABLED=1
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Transcrição local de áudio (instale com instalar_audio.bat)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Proteção opcional do painel/API local.
# Usuário HTTP Basic: luca. Preencha para exigir senha também no acesso local.
LUCA_ACCESS_PASSWORD=

# Caminho alternativo para o banco (padrão: ./data/luca.db).
# Compatibilidade: PIERRE_DATABASE_PATH ainda é aceito para bancos antigos.
# LUCA_DATABASE_PATH=

# Adaptador experimental da WhatsApp Business Cloud API.
# Só configure se o caso de uso cumprir os termos da Meta e houver webhook HTTPS seguro.
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_GRAPH_VERSION=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_ALLOWED_NUMBER=
