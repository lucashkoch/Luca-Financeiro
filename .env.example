# IA local via Ollama (opcional)
OLLAMA_ENABLED=0
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Transcrição local de áudio (instale com instalar_audio.bat).
# medium melhora o reconhecimento em português, mas usa mais memória/CPU que small.
# Os áudios são normalizados para WAV mono/16 kHz antes da transcrição.
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Proteção opcional do painel/API local.
# Usuário HTTP Basic: luca. Preencha para exigir senha também no acesso local.
LUCA_ACCESS_PASSWORD=

# Caminho alternativo para o banco (padrão: ./data/luca.db).
# Compatibilidade: PIERRE_DATABASE_PATH ainda é aceito para bancos antigos.
# LUCA_DATABASE_PATH=

# Bot Telegram oficial por long polling. Crie um único bot com @BotFather.
# Cada perfil vincula seu próprio Telegram pelo painel e pelo comando /vincular CÓDIGO.
# Não existe mais um ID único de usuário autorizado no .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLL_TIMEOUT=25
TELEGRAM_REMINDER_CHECK_SECONDS=60
TELEGRAM_MAX_AUDIO_MB=20
# Fila persistente: após quanto tempo sem polling considerar mensagens como recuperadas.
TELEGRAM_OFFLINE_THRESHOLD_SECONDS=120
# mixed = registra automaticamente só texto recuperado completo e inequívoco;
# confirm = sempre pedir confirmação. Áudios sempre pedem confirmação.
TELEGRAM_RECOVERED_TEXT_MODE=mixed

# Banco central de autenticação/perfis (opcional; padrão: ./data/luca-users.db).
# LUCA_CONTROL_DATABASE_PATH=
# Em uma hospedagem HTTPS, habilite cookies Secure. Não exponha HTTP público.
LUCA_COOKIE_SECURE=0
# Atualiza a foto de perfil do bot uma vez (e novamente se a imagem mudar).
TELEGRAM_PROFILE_PHOTO_ENABLED=1
TELEGRAM_PROFILE_PHOTO_PATH=branding/luca-telegram-avatar.jpg
