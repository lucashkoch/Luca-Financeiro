# IA local via Ollama (opcional)
OLLAMA_ENABLED=0
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Transcrição local de áudio (instale com instalar_audio.bat)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Proteção opcional do painel/API local.
# Usuário HTTP Basic: luca. Preencha para exigir senha também no acesso local.
LUCA_ACCESS_PASSWORD=

# Caminho alternativo para o banco (padrão: ./data/luca.db).
# Compatibilidade: PIERRE_DATABASE_PATH ainda é aceito para bancos antigos.
# LUCA_DATABASE_PATH=

# Bot pessoal do Telegram (gratuito). Crie o bot com @BotFather.
# Nunca publique este token nem o envie a terceiros.
TELEGRAM_BOT_TOKEN=
# Depois de enviar /start ao bot, copie seu ID numérico para este campo.
# Sem este ID, o bot só informa o ID do remetente e não acessa dados financeiros.
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_POLL_TIMEOUT=25
TELEGRAM_REMINDER_CHECK_SECONDS=60
TELEGRAM_MAX_AUDIO_MB=20
